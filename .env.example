# Production site URL
NEXT_PUBLIC_SITE_URL=https://osr.sa

# SMTP — use cPanel email credentials for osr.sa
SMTP_HOST=mail.osr.sa
SMTP_PORT=465
SMTP_USER=support@osr.sa
SMTP_PASS=your_email_password_here

# Who receives the contact/consultation/partner emails
MAIL_TO=support@osr.sa

# Display name in the From field
SMTP_FROM=OSR Website <support@osr.sa>
